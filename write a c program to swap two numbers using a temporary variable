#include <stdio.h>

int main() {
    double first, second, temp;

    printf("Enter first number: ");
    scanf("%lf", &first);
    printf("Enter second number: ");
    scanf("%lf", &second);

    // 1. Assign the value of first to temp
    temp = first;

    // 2. Assign the value of second to first
    first = second;

    // 3. Assign the value of temp (original first) to second
    second = temp;

    printf("\nAfter swapping, first number = %.2lf\n", first);
    printf("After swapping, second number = %.2lf", second);

    return 0;
}
