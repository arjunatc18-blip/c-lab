#include <stdio.h>

int main() {
    float num1, num2, sum, diff, prod;

    // Prompt user for input
    printf("Enter two numbers: ");
    scanf("%f %f", &num1, &num2);

    // Perform arithmetic operations
    sum = num1 + num2;
    diff = num1 - num2;
    prod = num1 * num2;

    // Display the results
    printf("Sum: %.2f\n", sum);
    printf("Difference: %.2f\n", diff);
    printf("Product: %.2f\n", prod);

    return 0;
}
